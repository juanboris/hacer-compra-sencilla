                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KnYF5Lh-EeuoK4ESIoDuPg" name="prePersist" specification="_Kez_wrh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>try {&#xD;
			created = MetodosAux.crearFecha();&#xD;
			modified = MetodosAux.crearFecha();&#xD;
		} catch (ParseException e) {&#xD;
			System.out.println(&quot;Fallo al formatear la fecha&quot;);&#xD;
			e.printStackTrace();&#xD;
		}&#xD;
&#xD;
		if (precio != null)&#xD;
		{&#xD;
			preciosHistoricos.add(BigDecimal.valueOf(Double.parseDouble(precio)));&#xD;
		}&#xD;
		&#xD;
		calcularMedia();&#xD;
	</body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KnYF5bh-EeuoK4ESIoDuPg" name="onPreUpdate" specification="_Kez_xrh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>try {&#xD;
			modified = MetodosAux.crearFecha();&#xD;
		} catch (ParseException e) {&#xD;
			System.out.println(&quot;Fallo al formatear la fecha&quot;);&#xD;
			e.printStackTrace();&#xD;
		}&#xD;
&#xD;
		if (precio != null)&#xD;
		{&#xD;
			preciosHistoricos.add(BigDecimal.valueOf(Double.parseDouble(precio)));&#xD;
		}&#xD;
		calcularMedia();&#xD;
 </body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KnYF5rh-EeuoK4ESIoDuPg" name="toString" specification="_Ke1N4bh-EeuoK4ESIoDuPg">
