                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_Knc-brh-EeuoK4ESIoDuPg" name="prePersist" specification="_Kff8Qrh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>try {&#xD;
			created = MetodosAux.crearFecha();&#xD;
			modified = MetodosAux.crearFecha();&#xD;
		} catch (ParseException e) {&#xD;
			System.out.println(&quot;Fallo al formatear la fecha&quot;);&#xD;
			e.printStackTrace();&#xD;
		}&#xD;
		&#xD;
		calcularPrecioTotal();&#xD;
	</body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KndlcLh-EeuoK4ESIoDuPg" name="onPreUpdate" specification="_Kff8Rrh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>try {&#xD;
			modified = MetodosAux.crearFecha();&#xD;
		} catch (ParseException e) {&#xD;
			System.out.println(&quot;Fallo al formatear la fecha&quot;);&#xD;
			e.printStackTrace();&#xD;
		}&#xD;
		calcularPrecioTotal();&#xD;
 </body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_Kndlcbh-EeuoK4ESIoDuPg" name="calcularPrecioTotal" specification="_KfgjUrh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>Double precioTotalProv = 0d;&#xD;
		BigDecimal precioTotal = null;&#xD;
		&#xD;
		if (productos != null &amp;&amp; productos.size() > 0)&#xD;
		{&#xD;
			precioTotalProv = productos.stream().mapToDouble(producto ->&#xD;
			Double.valueOf(producto.getProducto().getPrecio()) * Double.valueOf(producto.getCantidad())&#xD;
			).sum();&#xD;
		}&#xD;
&#xD;
		precioTotal = new BigDecimal(precioTotalProv);&#xD;
		precio = precioTotal;&#xD;
	</body>
                    </ownedBehavior>
