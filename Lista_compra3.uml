                        <name xsi:nil="true"/>
                        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                      </ownedParameter>
                      <language>java</language>
                      <body>return &quot;Producto [id=&quot; + productoId + &quot;, nombre=&quot; + nombre + &quot;, created=&quot; + created + &quot;, recetas=&quot; + recetas&#xD;
				+ &quot;, listas=&quot; + listas + &quot;]&quot;;&#xD;
	</body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KnYF6Lh-EeuoK4ESIoDuPg" name="calcularMedia" specification="_Ke1N5rh-EeuoK4ESIoDuPg">
                      <language>java</language>
                      <body>if (preciosHistoricos != null)&#xD;
		{&#xD;
			mediaPrecio = new BigDecimal(preciosHistoricos&#xD;
					.stream()&#xD;
					.mapToDouble(a -> a.doubleValue())&#xD;
					.average()&#xD;
					.getAsDouble());&#xD;
		}&#xD;
	</body>
                    </ownedBehavior>
