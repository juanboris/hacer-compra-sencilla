                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWglQ7h4EeuoK4ESIoDuPg" type="_kVbnMbh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>String username = MetodosAux.obtenerUsername(token);&#xD;
		return iProductoService.findAllByUsuarioIdEquals(PageRequest.of(page, 4, Sort.by(&quot;id&quot;)), obtenerUsuario(username).getId());	&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWglRLh4EeuoK4ESIoDuPg" name="show" specification="_kV-Zwbh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWglRbh4EeuoK4ESIoDuPg" name="id" type="_kV3FAbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWglRrh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>Producto producto = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		&#xD;
		try {&#xD;
			producto = iProductoService.findById(id);&#xD;
		} catch (DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_GET_BBDD);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		if (producto == null)&#xD;
		{&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;El producto ID: &quot; + id + &quot; no existe en la base de datos&quot;);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.NOT_FOUND);&#xD;
		}&#xD;
&#xD;
	    return new ResponseEntity&lt;Producto>(producto,HttpStatus.OK);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWhMULh4EeuoK4ESIoDuPg" name="createPorducto" specification="_kWAO8Lh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWhMUbh4EeuoK4ESIoDuPg" name="producto" type="_kVeqgbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWhMUrh4EeuoK4ESIoDuPg" name="result" type="_kVEa0bh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWhMU7h4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>Producto newProducto = null;&#xD;
		Producto productoBueno = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		if (result.hasErrors())&#xD;
		{&#xD;
			List&lt;String> errors = result.getFieldErrors()&#xD;
					.stream()&#xD;
					.map(err -> &quot;El campo '&quot; + err.getField() + &quot;' &quot; + err.getDefaultMessage())&#xD;
					.collect(Collectors.toList());&#xD;
			response.put(GeneralConstants.ERRORS_STRING, errors);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.BAD_REQUEST);&#xD;
		}&#xD;
		try {&#xD;
			productoBueno = new Producto(producto.getNombre(), producto.getPrecio(), producto.getMarca(), producto.getTipo());&#xD;
			newProducto = this.iProductoService.save(productoBueno);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_INSERT_BBDD);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;¡El producto ha sido creado con éxito!&quot;);&#xD;
		response.put(&quot;producto&quot;, newProducto);&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.CREATED);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWhMVLh4EeuoK4ESIoDuPg" name="update" specification="_kWBdE7h4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWhMVbh4EeuoK4ESIoDuPg" name="producto" type="_kVOL0Lh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWhMVrh4EeuoK4ESIoDuPg" name="result" type="_kVEa0bh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWhMV7h4EeuoK4ESIoDuPg" name="id" type="_kV3FAbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWhMWLh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>Producto currentProducto = this.iProductoService.findById(id);&#xD;
		Producto productoUpdated = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		&#xD;
		if (result.hasErrors())&#xD;
		{&#xD;
			List&lt;String> errors = result.getFieldErrors()&#xD;
					.stream()&#xD;
					.map(err -> &quot;El campo '&quot; + err.getField() + &quot;' &quot; + err.getDefaultMessage())&#xD;
					.collect(Collectors.toList());&#xD;
			response.put(GeneralConstants.ERRORS_STRING, errors);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.BAD_REQUEST);&#xD;
		}&#xD;
		&#xD;
		if (currentProducto == null)&#xD;
		{&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error: no se pudo editar, el producto ID: &quot; +&#xD;
			id + &quot; no existe en la base de datos&quot;);&#xD;
			return new ResponseEntity&lt;Map&lt;String,Object>>(response, HttpStatus.NOT_FOUND);&#xD;
		}&#xD;
	&#xD;
		try {&#xD;
			currentProducto.setNombre(producto.getNombre());&#xD;
			currentProducto.setPrecio(producto.getPrecio());&#xD;
			currentProducto.setMarca(producto.getMarca());&#xD;
			currentProducto.setTipo(producto.getTipo());&#xD;
			productoUpdated = iProductoService.save(currentProducto);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_UPDATE_BBDD);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}	&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;¡El producto ha sido modificado con éxito!&quot;);&#xD;
		response.put(&quot;producto&quot;, productoUpdated);&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.CREATED);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWhzYLh4EeuoK4ESIoDuPg" name="delete" specification="_kRosULh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWhzYbh4EeuoK4ESIoDuPg" name="id">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#long"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWhzYrh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		try {&#xD;
			Producto currentProducto = this.iProductoService.findById(id);&#xD;
			&#xD;
			if (currentProducto == null)&#xD;
			{&#xD;
				response.put(GeneralConstants.MENSAJE, &quot;Error: no se pudo borrar, el producto ID: &quot; +&#xD;
				id + &quot; no existe en la base de datos&quot;);&#xD;
				return new ResponseEntity&lt;Map&lt;String,Object>>(response, HttpStatus.NOT_FOUND);&#xD;
			}&#xD;
			this.iProductoService.delete(currentProducto);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error al borrar el producto en la base de datos&quot;);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;El producto se ha borrado correctamente&quot;);&#xD;
		&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.OK);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWhzY7h4EeuoK4ESIoDuPg" name="filtrarNombre" specification="_kRrIkLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWhzZLh4EeuoK4ESIoDuPg" name="term">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWhzZbh4EeuoK4ESIoDuPg" type="_kVeqgbh4EeuoK4ESIoDuPg" isOrdered="true" direction="return">
                      <name xsi:nil="true"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_kWhzZrh4EeuoK4ESIoDuPg" value="*"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>List&lt;Producto> productos = iProductoService.findByNombreStartingWithIgnoreCase(term);&#xD;
		List&lt;ProductoDTO> productoDTOs = new ArrayList&lt;ProductoDTO>();&#xD;
		for (Producto prod : productos)&#xD;
		{&#xD;
			ProductoDTO prodDTO = new ProductoDTO(prod.getId(), prod.getNombre(), &#xD;
					prod.getPrecio(), prod.getMarca(), prod.getTipo());&#xD;
			productoDTOs.add(prodDTO);&#xD;
		}&#xD;
		return productoDTOs;&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWiacLh4EeuoK4ESIoDuPg" name="filtrarNombre2" specification="_kRuL4Lh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWiacbh4EeuoK4ESIoDuPg" name="term">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWiacrh4EeuoK4ESIoDuPg" type="_kVOL0Lh4EeuoK4ESIoDuPg" isOrdered="true" direction="return">
                      <name xsi:nil="true"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_kWiac7h4EeuoK4ESIoDuPg" value="*"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>return iProductoService.findByNombreStartingWithIgnoreCase(term);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWiadLh4EeuoK4ESIoDuPg" name="tiposProductos" specification="_kRxPMLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWiadbh4EeuoK4ESIoDuPg" isOrdered="true" direction="return">
                      <name xsi:nil="true"/>
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_kWiadrh4EeuoK4ESIoDuPg" value="*"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>List&lt;String> tiposProducto = new ArrayList&lt;String>();&#xD;
		TiposProductoEnum[] tiposProductoEnums = TiposProductoEnum.values();&#xD;
		for (TiposProductoEnum tip : tiposProductoEnums)&#xD;
		{&#xD;
			tiposProducto.add(tip.getTipoProducto());&#xD;
		}&#xD;
		&#xD;
		return tiposProducto;&#xD;
	</body>
                  </ownedBehavior>
