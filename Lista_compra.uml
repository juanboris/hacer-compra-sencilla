                  <ownedAttribute xmi:id="_kWZ3kLh4EeuoK4ESIoDuPg" name="iUsuarioService" visibility="private" type="_kVSdQLh4EeuoK4ESIoDuPg" association="_kW3xobh4EeuoK4ESIoDuPg"/>
                  <ownedAttribute xmi:id="_kWZ3k7h4EeuoK4ESIoDuPg" name="passwordEncoder" visibility="private" type="_kVss8Lh4EeuoK4ESIoDuPg" association="_kW4YsLh4EeuoK4ESIoDuPg"/>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWnS8Lh4EeuoK4ESIoDuPg" name="createUsuario" specification="_kWORYLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWnS8bh4EeuoK4ESIoDuPg" name="usuario" type="_kVQBAbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWnS8rh4EeuoK4ESIoDuPg" name="result" type="_kVEa0bh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWnS87h4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return"/>
                    <language>java</language>
                    <body>Long id;&#xD;
		boolean encontrado = false;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		&#xD;
		encontrado = comprobarUsuario(usuario.getUsername());&#xD;
		&#xD;
		if (encontrado)&#xD;
		{&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;El usuario ya existe en la base de datos&quot;);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		&#xD;
		id = MetodosAux.obtenerProximoId(iUsuarioService.findAll(), &quot;Usuario&quot;);&#xD;
		usuario.setId(id);&#xD;
		&#xD;
		try {&#xD;
			usuario.setPassword(passwordEncoder.encode(usuario.getPassword()));&#xD;
			usuario.setEnabled(true);&#xD;
				&#xD;
		if (result.hasErrors())&#xD;
		{&#xD;
			List&lt;String> errors = result.getFieldErrors()&#xD;
					.stream()&#xD;
					.map(err -> &quot;El campo '&quot; + err.getField() + &quot;' &quot; + err.getDefaultMessage())&#xD;
					.collect(Collectors.toList());&#xD;
			response.put(GeneralConstants.ERRORS_STRING, errors);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.BAD_REQUEST);&#xD;
		}&#xD;
		&#xD;
			this.iUsuarioService.save(usuario);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_INSERT_BBDD);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}		&#xD;
		catch(NegativeNumberException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_INSERT_BBDD);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage());&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}		&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;¡El usuario ha sido creado con éxito!&quot;);&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.CREATED);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWn6ALh4EeuoK4ESIoDuPg" name="comprobarUsuario" specification="_kSdywLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWn6Abh4EeuoK4ESIoDuPg" name="usuario">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWn6Arh4EeuoK4ESIoDuPg" direction="return">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>boolean encontrado = false;&#xD;
		&#xD;
		for (Usuario usur : iUsuarioService.findAll())&#xD;
		{&#xD;
			if (usur.getUsername().equalsIgnoreCase(usuario))&#xD;
			{&#xD;
				encontrado = true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		return encontrado;&#xD;
	</body>
                  </ownedBehavior>
