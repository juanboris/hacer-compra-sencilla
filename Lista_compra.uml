                <packagedElement xmi:type="uml:Class" xmi:id="_kRVKULh4EeuoK4ESIoDuPg" name="ListaCompController">
                  <ownedAttribute xmi:id="_kWTw8Lh4EeuoK4ESIoDuPg" name="iListaCompService" visibility="package" type="_kVXVwLh4EeuoK4ESIoDuPg" association="_kW1VYbh4EeuoK4ESIoDuPg"/>
                  <ownedAttribute xmi:id="_kWUYArh4EeuoK4ESIoDuPg" name="iProductoService" visibility="package" type="_kVXVwrh4EeuoK4ESIoDuPg" association="_kW18cbh4EeuoK4ESIoDuPg"/>
                  <ownedAttribute xmi:id="_kWU_Erh4EeuoK4ESIoDuPg" name="iUsuarioService" visibility="package" type="_kVSdQLh4EeuoK4ESIoDuPg" association="_kW18dLh4EeuoK4ESIoDuPg"/>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWdh8Lh4EeuoK4ESIoDuPg" name="index" specification="_kRW_gLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWdh8bh4EeuoK4ESIoDuPg" name="token">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWdh8rh4EeuoK4ESIoDuPg" type="_kVMWobh4EeuoK4ESIoDuPg" isOrdered="true" direction="return">
                      <name xsi:nil="true"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_kWdh87h4EeuoK4ESIoDuPg" value="*"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>String username = MetodosAux.obtenerUsername(token);&#xD;
		return iListaCompService.findAll().stream()&#xD;
				.filter(listaCom -> listaCom.getUsuario().getId() == obtenerUsuario(username).getId())&#xD;
				.collect(Collectors.toList());&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWdh9Lh4EeuoK4ESIoDuPg" name="listaCompById" specification="_kV3FA7h4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWdh9bh4EeuoK4ESIoDuPg" name="id" type="_kV3FAbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWdh9rh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>ListaCom listaComp = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		&#xD;
		try {&#xD;
			listaComp = iListaCompService.findById(id);&#xD;
		} catch (DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_GET_BBDD);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		if (listaComp == null)&#xD;
		{&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;La lista de la compra ID: &quot; + id + &quot; no existe en la base de datos&quot;);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.NOT_FOUND);&#xD;
		}&#xD;
		&#xD;
		return new ResponseEntity&lt;ListaCom>(listaComp,HttpStatus.OK);&#xD;
		&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWeJALh4EeuoK4ESIoDuPg" name="createLista" specification="_kV46MLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWeJAbh4EeuoK4ESIoDuPg" name="listaCom" type="_kVMWobh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWeJArh4EeuoK4ESIoDuPg" name="result" type="_kVEa0bh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWeJA7h4EeuoK4ESIoDuPg" name="token">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWeJBLh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>listaCom = new ListaCom();		&#xD;
		ListaCom newListaCom = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		&#xD;
		String username = MetodosAux.obtenerUsername(token);&#xD;
		listaCom.setId(MetodosAux.obtenerProximoId(iListaCompService.findAll(), GeneralConstants.LISTA_COMP_STRING));&#xD;
		listaCom.setUsuario(obtenerUsuario(username));&#xD;
		&#xD;
		if (result.hasErrors())&#xD;
		{&#xD;
			List&lt;String> errors = result.getFieldErrors()&#xD;
					.stream()&#xD;
					.map(err -> &quot;El campo '&quot; + err.getField() + &quot;' &quot; + err.getDefaultMessage())&#xD;
					.collect(Collectors.toList());&#xD;
			response.put(GeneralConstants.ERRORS_STRING, errors);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.BAD_REQUEST);&#xD;
		}&#xD;
		try {&#xD;
			newListaCom = this.iListaCompService.save(listaCom);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, GeneralConstants.FALLO_INSERT_BBDD);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}		&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;¡La lista ha sido creada con éxito!&quot;);&#xD;
		response.put(&quot;listaCom&quot;, newListaCom);&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.CREATED);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWeJBbh4EeuoK4ESIoDuPg" name="update" specification="_kV6vYrh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWeJBrh4EeuoK4ESIoDuPg" name="listaComp" type="_kVMWobh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWeJB7h4EeuoK4ESIoDuPg" name="result" type="_kVEa0bh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWeJCLh4EeuoK4ESIoDuPg" name="id" type="_kV3FAbh4EeuoK4ESIoDuPg"/>
                    <ownedParameter xmi:id="_kWeJCbh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>ListaCom currentLista = this.iListaCompService.findById(id);&#xD;
		ListaCom listaUpdated = null;&#xD;
		Map&lt;String, Object> response = new HashMap&lt;>();		&#xD;
		&#xD;
		if (result.hasErrors())&#xD;
		{&#xD;
			List&lt;String> errors = result.getFieldErrors()&#xD;
					.stream()&#xD;
					.map(err -> &quot;El campo '&quot; + err.getField() + &quot;' &quot; + err.getDefaultMessage())&#xD;
					.collect(Collectors.toList());&#xD;
			response.put(GeneralConstants.ERRORS_STRING, errors);&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.BAD_REQUEST);&#xD;
		}&#xD;
		&#xD;
		if (currentLista == null)&#xD;
		{&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error: no se pudo editar, el producto ID: &quot; +&#xD;
			id + &quot; no existe en la base de datos&quot;);&#xD;
			return new ResponseEntity&lt;Map&lt;String,Object>>(response, HttpStatus.NOT_FOUND);&#xD;
		}&#xD;
	&#xD;
		try {&#xD;
			currentLista.setCreated(listaComp.getCreated());&#xD;
			&#xD;
			/*Función que revisa si todos los objetos de la lista&#xD;
			 * de productos de la lista la compra tienen establecido&#xD;
			 * el ListaCompId. Si no tienen, se lo inserta.&#xD;
			 * Luego se hace un set a cada uno de los objetos&#xD;
			 * para actualizar su precio*/&#xD;
			currentLista.setProductos(listaComp.getProductos());&#xD;
			if (listaComp.getProductos().size() > 0)&#xD;
			{&#xD;
				currentLista.getProductos().forEach(prod ->{&#xD;
					String precio = prod.getProducto().getPrecio().contains(&quot;,&quot;) ? &#xD;
							prod.getProducto().getPrecio().replace(&quot;,&quot;, &quot;.&quot;) : prod.getProducto().getPrecio();&#xD;
					prod.getProducto().setPrecio(precio);&#xD;
					if (Double.parseDouble(prod.getProducto().getPrecio()) &lt; 0)&#xD;
					{&#xD;
						throw new NegativeNumberException(&quot;El precio no puede ser negativo&quot;);&#xD;
					}&#xD;
					else if (prod.getId().getListaCompId() == null)&#xD;
					{&#xD;
						prod.getId().setListaCompId(id);&#xD;
					}&#xD;
					Producto currentProducto = iProductoService.findById(prod.getId().getProductoId());&#xD;
					currentProducto.setPrecio(prod.getProducto().getPrecio());&#xD;
				});&#xD;
			}&#xD;
			else {&#xD;
				currentLista.setProductos(null);&#xD;
			}&#xD;
			listaUpdated = iListaCompService.save(currentLista);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error al introducir la lista de la compra en la base de datos&quot;);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		catch (NegativeNumberException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error al introducir la lista de la compra en la base de datos&quot;);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage());&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		catch (NumberFormatException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Has introducido un formato de número incorrecto&quot;);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage());&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;¡La lista de la compra ha sido modificada con éxito!&quot;);&#xD;
		response.put(&quot;listaComp&quot;, listaUpdated);&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.CREATED);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWeJCrh4EeuoK4ESIoDuPg" name="delete" specification="_kRZbwLh4EeuoK4ESIoDuPg">
                    <ownedParameter xmi:id="_kWeJC7h4EeuoK4ESIoDuPg" name="id">
                      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#long"/>
                    </ownedParameter>
                    <ownedParameter xmi:id="_kWeJDLh4EeuoK4ESIoDuPg" type="_kVDzwrh4EeuoK4ESIoDuPg" direction="return">
                      <name xsi:nil="true"/>
                    </ownedParameter>
                    <language>java</language>
                    <body>Map&lt;String, Object> response = new HashMap&lt;>();&#xD;
		try {&#xD;
			ListaCom currentLista = this.iListaCompService.findById(id);&#xD;
			&#xD;
			if (currentLista == null)&#xD;
			{&#xD;
				response.put(GeneralConstants.MENSAJE, &quot;Error: no se pudo borrar, la lista de la compra ID: &quot; +&#xD;
				id + &quot; no existe en la base de datos&quot;);&#xD;
				return new ResponseEntity&lt;Map&lt;String,Object>>(response, HttpStatus.NOT_FOUND);&#xD;
			}&#xD;
			this.iListaCompService.delete(currentLista);&#xD;
		} catch(DataAccessException e) {&#xD;
			response.put(GeneralConstants.MENSAJE, &quot;Error al borrar la lista de la compra en la base de datos&quot;);&#xD;
			response.put(GeneralConstants.ERROR, e.getMessage().concat(&quot;: &quot;).concat(e.getMostSpecificCause().getMessage()));&#xD;
			return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.INTERNAL_SERVER_ERROR);&#xD;
		}&#xD;
		response.put(GeneralConstants.MENSAJE, &quot;La lista de la compra se ha borrado correctamente&quot;);&#xD;
		&#xD;
		return new ResponseEntity&lt;Map&lt;String, Object>>(response, HttpStatus.OK);&#xD;
	</body>
                  </ownedBehavior>
                  <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_kWfXILh4EeuoK4ESIoDuPg" name="obtenerUsuario" specification="_kRbQ8Lh4EeuoK4ESIoDuPg">
