                    <ownedAttribute xmi:id="_KySnUrh8EeuoK4ESIoDuPg" name="logger" visibility="private" type="_Kxn48bh8EeuoK4ESIoDuPg" association="_KycYVLh8EeuoK4ESIoDuPg">
                      <defaultValue xmi:type="uml:LiteralString" xmi:id="_KySnU7h8EeuoK4ESIoDuPg" value="LoggerFactory.getLogger(UsuarioServiceImpl.class)"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_bTIjcLh8EeuoK4ESIoDuPg" name="iUsuarioDAO" visibility="private" type="_KvYdQLh8EeuoK4ESIoDuPg" association="_bTKYobh8EeuoK4ESIoDuPg"/>
                    <interfaceRealization xmi:id="_KyNHwLh8EeuoK4ESIoDuPg" client="_Kv6BsLh8EeuoK4ESIoDuPg" supplier="_KxqVMLh8EeuoK4ESIoDuPg" contract="_KxqVMLh8EeuoK4ESIoDuPg"/>
                    <interfaceRealization xmi:id="_Kxq8Qbh8EeuoK4ESIoDuPg" client="_Kv6BsLh8EeuoK4ESIoDuPg" supplier="_KvnGwLh8EeuoK4ESIoDuPg" contract="_KvnGwLh8EeuoK4ESIoDuPg"/>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KyW4ybh8EeuoK4ESIoDuPg" name="loadUserByUsername" specification="_Kv6owbh8EeuoK4ESIoDuPg">
                      <ownedParameter xmi:id="_KyW4yrh8EeuoK4ESIoDuPg" name="username">
                        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                      </ownedParameter>
                      <ownedParameter xmi:id="_KyW4y7h8EeuoK4ESIoDuPg" type="_KxpuIbh8EeuoK4ESIoDuPg" direction="return">
                        <name xsi:nil="true"/>
                      </ownedParameter>
                      <language>java</language>
                      <body>Usuario usuario = iUsuarioDAO.findByUsername(username);&#xD;
		&#xD;
		if (usuario == null)&#xD;
		{&#xD;
			String mensaje = &quot;Error en el login: no existe el usuario '&quot; + username + &quot;' en el sistema!&quot;;&#xD;
			logger.error(mensaje);&#xD;
			throw new UsernameNotFoundException(mensaje);&#xD;
		&#xD;
		}&#xD;
		List&lt;GrantedAuthority> authorities = usuario.getRoles()&#xD;
				.stream()&#xD;
				.map(e -> new SimpleGrantedAuthority(e.getNombre()))&#xD;
				.peek(e -> logger.info(&quot;Role: &quot; + e.getAuthority()))&#xD;
				.collect(Collectors.toList());&#xD;
		return new User(usuario.getUsername(), usuario.getPassword(), usuario.getEnabled(), true, true, true, authorities);&#xD;
	</body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KyXf0Lh8EeuoK4ESIoDuPg" name="findByUsername" specification="_Kv724Lh8EeuoK4ESIoDuPg">
                      <ownedParameter xmi:id="_KyXf0bh8EeuoK4ESIoDuPg" name="username">
                        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                      </ownedParameter>
                      <ownedParameter xmi:id="_KyXf0rh8EeuoK4ESIoDuPg" type="_KxZ2gbh8EeuoK4ESIoDuPg" direction="return">
                        <name xsi:nil="true"/>
                      </ownedParameter>
                      <language>java</language>
                      <body>return iUsuarioDAO.findByUsername(username);&#xD;
		 &#xD;
	</body>
                    </ownedBehavior>
                    <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_KyXf07h8EeuoK4ESIoDuPg" name="findAll" specification="_Kv8d9bh8EeuoK4ESIoDuPg">
